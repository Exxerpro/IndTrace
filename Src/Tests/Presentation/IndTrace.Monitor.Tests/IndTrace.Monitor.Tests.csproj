<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Microsoft Testing Platform Configuration -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformServer>true</TestingPlatformServer>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Fobiden to add global scoped NoWarn  violator to this rule will be prosecuted -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="bunit" />
    <!-- Direct reference lifts bunit's transitive AngleSharp 1.4.0 (GHSA-pgww-w46g-26qg, NU1902) to a patched version. -->
    <PackageReference Include="AngleSharp" />
  </ItemGroup>
  <!-- Microsoft Testing Platform -->
  <ItemGroup Label="Microsoft Testing Platform">
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <!-- xUnit v3 (MTP v2) -->
  <ItemGroup Label="xUnit v3">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3.runner.inproc.console">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.runner.msbuild">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Microsoft Testing Platform Configuration -->
  <ItemGroup>
    <ProjectCapability Include="DiagnoseCapabilities" />
    <ProjectCapability Include="TestingPlatformServer" />
    <ProjectCapability Include="TestContainer" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\XunitAutoGeneratedEntryPoint.cs" />
    <Compile Remove="obj\**\XunitAutoGeneratedEntryPoint.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IndQuestResults" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <!-- Issue #71 regression coverage for HubMonitorWorker. IndTrace.Monitor is a self-contained exe
       (NETSDK1151 forbids referencing it from a framework-dependent test), so we reference the
       libraries the worker depends on and source-link the worker itself: the real SUT source is
       compiled into this test assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Code\Core\Application\IndTrace.Application.csproj" />
    <ProjectReference Include="..\..\..\Code\Infrastructure\IndTrace.HubConnection\IndTrace.HubConnection.csproj" />
    <!-- Issue #82: SVG culture-invariance regression tests render the OEE gauge/sparkline components. -->
    <ProjectReference Include="..\..\..\Code\Presentation\IndTrace.Components\IndTrace.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Code\Presentation\IndTrace.Monitor\Worker\HubMonitorWorker.cs" Link="Linked\HubMonitorWorker.cs" />
    <Compile Include="..\..\..\Code\Presentation\IndTrace.Monitor\MonitorServiceRegistration.cs" Link="Linked\MonitorServiceRegistration.cs" />
    <Compile Include="..\..\..\Code\Presentation\IndTrace.Monitor\Components\Account\AccountServiceRegistration.cs" Link="Linked\Account\AccountServiceRegistration.cs" />
    <Compile Include="..\..\..\Code\Presentation\IndTrace.Monitor\Components\Account\IdentityRedirectManager.cs" Link="Linked\Account\IdentityRedirectManager.cs" />
    <Compile Include="..\..\..\Code\Presentation\IndTrace.Monitor\Components\Account\IdentityUserAccessor.cs" Link="Linked\Account\IdentityUserAccessor.cs" />
    <Compile Include="..\..\..\Code\Presentation\IndTrace.Monitor\Components\Account\IdentityNoOpEmailSender.cs" Link="Linked\Account\IdentityNoOpEmailSender.cs" />
    <!-- The linked account helpers rely on the Web SDK implicit usings of the Monitor project. -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <!-- HubMonitorWorker (a BackgroundService) relies on the Web SDK's implicit Hosting using. -->
    <Using Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>