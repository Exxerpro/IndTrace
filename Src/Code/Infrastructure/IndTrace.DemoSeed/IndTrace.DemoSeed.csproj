<Project Sdk="Microsoft.NET.Sdk">
  <!-- ============================================================================ -->
  <!-- CORE PROPERTIES -->
  <!-- ============================================================================ -->
  <!-- Creates a demo-ready IndTrace database: applies the EF Core migrations, then writes a small fictitious
       production line (stations, simulated PLCs with their tags, customers, products, routes, label rules and
       recipes) and a demo sign-in user. Independent of the unit-test fixtures, which are shaped for tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IndTrace.DemoSeed</RootNamespace>
    <AssemblyName>IndTrace.DemoSeed</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Override the repo-wide InvariantGlobalization=true: Microsoft.Data.SqlClient refuses invariant mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES -->
  <!-- ============================================================================ -->
  <ItemGroup>
    <PackageReference Include="IndQuestResults" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>
  <!-- ============================================================================ -->
  <!-- PROJECT REFERENCES -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Core References">
    <ProjectReference Include="..\..\Core\Domain\IndTrace.Domain.csproj" />
    <ProjectReference Include="..\..\Core\Application\IndTrace.Application.csproj" />
    <ProjectReference Include="..\IndTrace.Persistence\IndTrace.Persistence.csproj" />
    <ProjectReference Include="..\IndTrace.Identity\IndTrace.Identity.csproj" />
  </ItemGroup>
</Project>
