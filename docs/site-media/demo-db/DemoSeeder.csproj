<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds a demo database from the repository's fictitious test fixtures. Not part of IndTrace.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SrcRoot>$(MSBuildThisFileDirectory)../../../Src/</SrcRoot>
    <!-- IndTrace.TestData pulls in xUnit, whose generated entry point would compete with this program's. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- EF1002: the raw SQL only interpolates table names read from the EF model, never user input. -->
    <NoWarn>$(NoWarn);EF1002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Code/Infrastructure/IndTrace.Persistence/IndTrace.Persistence.csproj" />
    <ProjectReference Include="$(SrcRoot)Code/Infrastructure/IndTrace.Identity/IndTrace.Identity.csproj" />
    <!-- Outside Src/, so the single-consumer guard on IndTrace.TestData does not apply to this tool. -->
    <ProjectReference Include="$(SrcRoot)Tests/Core/IndTrace.TestData/IndTrace.TestData.csproj" />
  </ItemGroup>
</Project>
